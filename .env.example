# Nest — environment variables
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables (Production + Preview).
# Never commit real values. VITE_* values are PUBLIC: they are compiled into the browser bundle and static pages.

# ── Firebase web app (public config, REQUIRED) ────────────────
# Firebase console → Project settings → Your apps → Web app. Without these the app shows a "Firebase not configured" screen.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=              # e.g. your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=           # e.g. your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=           # optional (Google Analytics)

# ── Site / domains (public) ───────────────────────────────────
VITE_SITE_URL=                          # REQUIRED for production, e.g. https://nest.example.com (no trailing slash)
VITE_LEGACY_HOSTS=                      # optional, comma-separated old hostnames allowed for auth / OAuth returns
VITE_GITHUB_OAUTH_HOST=                 # optional, host whose /api/github/callback is on your GitHub OAuth App (default: your site)
VITE_CONTACT_EMAIL=                     # public contact address (site footer, FAQ, legal pages, Help link, status page)
VITE_ADMIN_EMAILS=                      # comma-separated admin emails (client-side hint only; the server checks NEST_ADMIN_EMAILS)
VITE_TEST_EMAIL_DOMAINS=                # comma-separated email domains of your own test accounts (default: nest-test.invalid)
VITE_GOOGLE_CLIENT_ID=                  # Google OAuth web client id (Google connections); usually same as GOOGLE_CLIENT_ID
VITE_GOOGLE_SITE_VERIFICATION=          # optional, comma-separated Google Search Console tokens
VITE_INDEXNOW_KEY=                      # optional, 32 hex chars; the build writes /<key>.txt

# ── AI providers ──────────────────────────────────────────────
AGNES_API_KEY=              # Agnes AI (agnes-3.0-flash), final fallback model
ORCAROUTER_API_KEY=         # OrcaRouter free models (DeepSeek / Hunyuan / GLM)
GEMINI_API_KEY=             # Google AI Studio (Gemini / Gemma)
MISTRAL_API_KEY=            # Mistral (Ministral / Codestral)

# ── Web search grounding (optional; keyless mode used when empty) ──
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ── Firebase (server) ─────────────────────────────────────────
FIREBASE_PROJECT_ID=        # same as VITE_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT=   # service-account JSON, single line

# ── Admin / accounts (server) ─────────────────────────────────
NEST_ADMIN_EMAILS=          # comma-separated verified emails allowed into /admin (falls back to VITE_ADMIN_EMAILS)
NEST_OFFICIAL_UID=          # optional, Firebase uid of the official "nest" account (admin by uid + email)
NEST_KEEP_TEST_EMAILS=      # optional, test accounts the admin cleanup keeps (default nest-test-owner/-member@<first test domain>)
NEST_TEST_FAMILY_ID=        # optional, family id of the standing test family (promo reset in admin cleanup)
NEST_API_REFERER=           # optional, Referer sent with Identity Toolkit calls (for referrer-restricted API keys; default your site)

# ── Google connector (Gmail / Calendar / Classroom / Drive) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub connection (OAuth App) ─────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
NEST_EMAIL_FROM=            # e.g. Nest <noreply@example.com> (domain verified in Resend; default noreply@<your site host>)

# ── Web push (VAPID) ──────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=              # e.g. mailto:you@example.com (default mailto:<VITE_CONTACT_EMAIL>)

# ── Server secrets (any long random strings) ──────────────────
TOKEN_ENC_KEY=              # encrypts stored OAuth tokens (32 random bytes, base64)
NEST_LEDGER_SECRET=         # server-only ledger accounts
CRON_SECRET=                # protects cron endpoints

# ── Deploy / local dev / tests only ───────────────────────────
VERCEL_PROJECT=             # scripts/deploy.mjs target project name
PORT=
LIVE=                       # set to 1 to run live tests
CHROME=                     # path to Chrome for screenshot scripts
GOOGLE_ACCESS_TOKEN=        # live connector tests / scripts/publish-rules.mjs
DIST=
HERO_PATH=
NEST_CHANGELOG_STRICT=
