rules_version = '2';
// Nest 巢 — Firestore security rules
// Members can only read/write their own family's data. Invites are readable by token
// (get only, never listed). Plans can only be "free" until payments go live.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function fam(fid) { return get(famPath(fid)).data; }
    function isMember(fid) { return signedIn() && exists(famPath(fid)) && request.auth.uid in fam(fid).memberIds; }
    function isOwner(fid) { return signedIn() && exists(famPath(fid)) && fam(fid).ownerId == request.auth.uid; }
    function memberLimit(plan) { return plan == 'pro' ? 10 : (plan == 'starter' ? 6 : 3); }
    // AI messages per family. Keep in sync with src/lib/plans.js.
    function dayLimit(plan) { return plan == 'pro' ? 800 : (plan == 'starter' ? 300 : 100); }
    function weekLimit(plan) { return plan == 'pro' ? 4000 : (plan == 'starter' ? 1500 : 400); }
    function usageLimit(fid, key) {
      return key.matches('^d-[0-9]{4}-[0-9]{2}-[0-9]{2}$') ? dayLimit(fam(fid).plan) : weekLimit(fam(fid).plan);
    }
    function validUsageKey(key) {
      return key.matches('^d-[0-9]{4}-[0-9]{2}-[0-9]{2}$') || key.matches('^w-[0-9]{4}-W[0-9]{2}$');
    }
    function validInvite(token, fid) {
      return token is string
        && exists(/databases/$(database)/documents/invites/$(token))
        && get(/databases/$(database)/documents/invites/$(token)).data.familyId == fid
        && get(/databases/$(database)/documents/invites/$(token)).data.expiresAt > request.time;
    }

    // Private profile: only the user themself.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      // Web Push subscriptions, one doc per device (id = "s" + sha256(endpoint)[0:24]).
      // Written by /api/push/subscribe with the owner's own ID token; read by /api/push/test the same way.
      // The daily cron reads them with a service account (bypasses rules).
      match /pushSubs/{sid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && sid.matches('^s[0-9a-f]{24}$')
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'ua', 'createdAt'])
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.size() < 1000
          && request.resource.data.endpoint.matches('^https://.*')
          && request.resource.data['keys'] is map;
      }
    }

    // Waitlist for the paid plans (payments are not live). Written by /api/waitlist only:
    // create-only (no reads, updates or deletes from clients), doc id = "w" + sha256(email|plan)[0:32] dedupes.
    // Logged-out visitors may create too, so every field is validated.
    match /waitlist/{id} {
      allow read, update, delete: if false;
      allow create: if id.matches('^w[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['email', 'plan', 'billing', 'note', 'lang', 'source', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'plan', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.plan in ['starter', 'pro']
        && (!('billing' in request.resource.data) || request.resource.data.billing in ['monthly', 'yearly'])
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (!('lang' in request.resource.data) || request.resource.data.lang in ['zh-Hant', 'en'])
        && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 32))
        && (!('uid' in request.resource.data) || request.resource.data.uid == null
            || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time;
    }

    // Invite links /join/<token>: readable by token by any signed-in user, never listable.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.familyId);
      allow delete: if isMember(resource.data.familyId);
    }

    // Short invite codes map to a token.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isMember(request.resource.data.familyId);
      allow delete: if isMember(resource.data.familyId);
    }

    match /families/{fid} {
      allow read: if isMember(fid);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.plan == 'free';

      allow update: if
        // Owner: rename, remove members, transfer ownership to a member. Never the plan.
        (isOwner(fid)
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.memberIds.size() <= memberLimit(resource.data.plan)
          && request.resource.data.ownerId in request.resource.data.memberIds)
        // Joining with an invite: add only yourself, within the plan's member limit,
        // in the same batch that creates your member doc (validated below).
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= memberLimit(resource.data.plan)
          && existsAfter(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)))
        // Leaving (non-owner): remove only yourself.
        || (isMember(fid)
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1);

      allow delete: if isOwner(fid) && resource.data.memberIds.size() == 1;

      match /members/{uid} {
        allow read: if isMember(fid);
        allow create: if signedIn() && request.auth.uid == uid && (
          // The owner, in the batch that creates the family.
          (getAfter(famPath(fid)).data.ownerId == request.auth.uid && request.resource.data.isOwner == true)
          // Anyone holding a valid, unexpired invite for this family.
          || (validInvite(request.resource.data.inviteToken, fid) && request.resource.data.isOwner == false)
        );
        allow update: if isOwner(fid)
          || (request.auth.uid == uid && isMember(fid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'photoURL', 'birthday'])
              && (!('birthday' in request.resource.data) || request.resource.data.birthday == ''
                  || request.resource.data.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
        allow delete: if isOwner(fid) || request.auth.uid == uid;
      }

      match /invites/{token} {
        allow read, write: if isMember(fid);
      }

      match /memories/{id} {
        allow read, update, delete: if isMember(fid);
        allow create: if isMember(fid) && request.resource.data.createdBy == request.auth.uid;
      }

      match /reminders/{id} {
        allow read, update, delete: if isMember(fid);
        allow create: if isMember(fid) && request.resource.data.createdBy == request.auth.uid;
      }

      // AI usage counters, written by /api/chat with the caller's own ID token.
      // One doc per Hong Kong day (d-2026-10-17) and per ISO week (w-2026-W42).
      // Each can only go up by one per message, and never past the family plan's limit.
      match /usage/{key} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validUsageKey(key)
          && request.resource.data.keys().hasOnly(['count', 'perMember'])
          && request.resource.data.count == 1
          && request.resource.data.count <= usageLimit(fid, key);
        allow update: if isMember(fid) && validUsageKey(key)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'perMember'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= usageLimit(fid, key);
      }

      // Chats are private to the member who owns them.
      match /conversations/{cid} {
        allow read, update, delete: if isMember(fid) && resource.data.ownerId == request.auth.uid;
        allow create: if isMember(fid) && request.resource.data.ownerId == request.auth.uid;
        match /messages/{mid} {
          allow read, write: if isMember(fid)
            && get(/databases/$(database)/documents/families/$(fid)/conversations/$(cid)).data.ownerId == request.auth.uid;
        }
      }

      match /quizResults/{id} {
        allow read, update, delete: if isMember(fid) && resource.data.uid == request.auth.uid;
        allow create: if isMember(fid) && request.resource.data.uid == request.auth.uid;
      }

      // Calendar sharing (opt-in): each member publishes a compact snapshot of their own upcoming events.
      match /calendarShare/{uid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'events', 'updatedAt'])
          && request.resource.data.uid == uid && request.resource.data.events is list && request.resource.data.events.size() <= 400;
        allow delete: if isMember(fid) && (request.auth.uid == uid || isOwner(fid));
      }

      match /inbox/{id} {
        allow read, update, delete: if isMember(fid) && resource.data.uid == request.auth.uid;
        allow create: if isMember(fid) && request.resource.data.uid == request.auth.uid;
      }
    }
  }
}
